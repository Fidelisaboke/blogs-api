# App Configuration
BASE_URL=http://localhost:3000
LOG_LEVEL=info
PORT=3000
NODE_ENV=development

# Database Configuration
DB_NAME=blogs_api
DB_USER=blog_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Note: Ensure DATABASE_URL stays in sync with the individual DB_* variables above
DATABASE_URL=postgresql://blog_user:changeme@localhost:5433/blogs_api

# Better Auth Configuration (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-32-character-secret-here
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=someone@example.com
