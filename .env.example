# App Configuration
BASE_URL=http://localhost:3000
LOG_LEVEL=info
PORT=3000
NODE_ENV=development

# Root Organization Configuration
# WARNING: The root organization has unrestricted global access to all blogs and users.
# Only configure this in trusted environments with proper access controls.
# Format: Leave empty to disable, or provide a valid organization ID (UUID format expected)
ROOT_ORGANIZATION_ID=

# Database Configuration
DB_NAME=blogs_api
DB_USER=blog_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Note: Ensure DATABASE_URL stays in sync with the individual DB_* variables above
DATABASE_URL=postgresql://blog_user:changeme@localhost:5433/blogs_api

# Better Auth Configuration (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-32-character-secret-here
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=someone@example.com

# Security & Limits Configuration
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=100
